# Copy to .env and adjust. Every value below is read by app/core/config.py.
# Compose also consumes POSTGRES_* and API_PORT for its own configuration.

# --- Application ----------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Security -------------------------------------------------------------
# Protects write endpoints (profile updates, manual analysis). Change it.
API_KEY=dev-secret-change-me
# Empty list means "any Telegram user is allowed to register".
TELEGRAM_ALLOWED_USER_IDS=[]
# Used when a request carries no X-Telegram-Id header (local demo / curl).
DEMO_TELEGRAM_ID=100000001

# --- Caching --------------------------------------------------------------
STATS_CACHE_ENABLED=true

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
DB_ECHO=false
# Full DSN overrides the parts above. Driver prefix is added automatically.
# DATABASE_URL=postgresql://radar:radar@localhost:5432/radar

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Collection / HTTP ----------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_SECONDS=0.5
HTTP_MAX_CONNECTIONS=10
HTTP_USER_AGENT=AI-Job-Radar/0.1 (+https://github.com/your-handle/ai-job-radar)
COLLECTOR_BATCH_SIZE=50
# Beat schedule (minutes)
COLLECT_INTERVAL_MINUTES=15
ANALYZE_INTERVAL_MINUTES=5
NOTIFY_INTERVAL_MINUTES=2
STATS_INTERVAL_MINUTES=5
STALE_VACANCY_DAYS=60
ANALYSIS_LOOKBACK_DAYS=14
NOTIFICATION_BATCH_SIZE=20

# --- AI -------------------------------------------------------------------
# mock  -> deterministic heuristic scorer, no API key, no cost (default)
# openai -> any OpenAI-compatible endpoint (OPENAI_BASE_URL for proxies/local LLMs)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_ANALYSES_PER_RUN=50
AI_DAILY_BUDGET_USD=2.0
AI_FALLBACK_TO_MOCK=true
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
